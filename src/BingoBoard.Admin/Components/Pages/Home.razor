@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.SignalR.Client
@inject IBingoService BingoService
@inject IClientConnectionService ClientService
@inject AddressResolver AddressResolver

@implements IAsyncDisposable

<PageTitle>Dashboard · AspiriFridays Admin</PageTitle>

<div class="page-header">
    <h1>Dashboard</h1>
    <div class="page-actions">
        <button @onclick="RefreshClients" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-rotate" aria-hidden="true"></i> Refresh
        </button>
        <button @onclick="BroadcastMessage" class="btn btn-primary btn-sm">
            <i class="fas fa-bullhorn" aria-hidden="true"></i> Send announcement
        </button>
    </div>
</div>

<div class="stack">
    <div class="split-grid">
        <section class="card" aria-labelledby="players-title">
            <div class="card-header">
                <h2 class="card-title" id="players-title">Connected players</h2>
                <span class="count">@(ConnectedClients?.Count ?? 0)</span>
            </div>
            @if (ConnectedClients?.Any() == true)
            {
                <ul class="data-list card-scroll">
                    @foreach (var client in ConnectedClients)
                    {
                        <li>
                            <div class="data-list__primary">
                                <strong class="mono">@ShortId(client.ConnectionId)</strong>
                                <small>
                                    @if (!string.IsNullOrEmpty(client.UserName))
                                    {
                                        <text>@client.UserName · </text>
                                    }
                                    Joined @client.ConnectedAt.ToString("HH:mm:ss")
                                </small>
                            </div>
                            @if (!string.IsNullOrEmpty(client.CurrentBingoSetId))
                            {
                                <span class="status status--ok">Has board</span>
                            }
                            else
                            {
                                <span class="status status--idle">No board</span>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="empty">No players connected</p>
            }
        </section>

        <section class="card" aria-labelledby="inspect-title">
            <div class="card-header">
                <h2 class="card-title" id="inspect-title">Inspect a board</h2>
            </div>
            <div class="card-body">
                <label for="clientSelect" class="form-label">Player</label>
                <div class="inline-field">
                    <select @bind="selectedClientConnectionId" class="form-select" id="clientSelect">
                        <option value="">Select a player</option>
                        @foreach (var client in ConnectedClients?.Where(c => !string.IsNullOrEmpty(c.CurrentBingoSetId)) ?? [])
                        {
                            <option value="@client.ConnectionId">
                                @ShortId(client.ConnectionId) @(!string.IsNullOrEmpty(client.UserName) ? $"({client.UserName})" : "")
                            </option>
                        }
                    </select>
                    <button @onclick="LoadClientBingoSet" class="btn btn-primary" disabled="@string.IsNullOrEmpty(selectedClientConnectionId)">
                        Load board
                    </button>
                </div>
            </div>
        </section>
    </div>

    @if (currentClientBingoSet != null && !string.IsNullOrEmpty(selectedClientConnectionId))
    {
        <section class="card" aria-labelledby="board-title">
            <div class="card-header">
                <h2 class="card-title" id="board-title">
                    Board <span class="mono">@ShortId(selectedClientConnectionId)</span>
                </h2>
                @if (currentClientBingoSet.HasWin)
                {
                    <span class="badge bg-success">Bingo</span>
                }
            </div>
            <div class="card-body">
                <div class="bingo-grid">
                    @for (int i = 0; i < 25; i++)
                    {
                        var square = currentClientBingoSet.Squares[i];

                        <button type="button"
                                class="bingo-square @(square.IsChecked ? "checked" : "") @(square.Type == "free" ? "square-free" : "")"
                                aria-pressed="@square.IsChecked.ToString().ToLowerInvariant()"
                                @onclick="() => ToggleSquare(square.Id, !square.IsChecked)">
                            <span class="square-text">@square.Label</span>
                            @if (square.IsChecked)
                            {
                                <i class="fas fa-check check-mark" aria-hidden="true"></i>
                            }
                        </button>
                    }
                </div>
            </div>
        </section>
    }

    <section class="card" aria-labelledby="log-title">
        <div class="card-header">
            <h2 class="card-title" id="log-title">Activity</h2>
            <button @onclick="ClearLog" class="btn btn-ghost btn-sm" disabled="@(!activityLog.Any())">Clear</button>
        </div>
        @if (activityLog.Any())
        {
            <ul class="log card-scroll">
                @foreach (var log in activityLog.OrderByDescending(l => l.Timestamp))
                {
                    <li><time>@log.Timestamp.ToString("HH:mm:ss")</time><span>@log.Message</span></li>
                }
            </ul>
        }
        else
        {
            <p class="empty">No activity yet</p>
        }
    </section>
</div>

@code {
    private HubConnection? hubConnection;
    [PersistentState]
    public List<ConnectedClient>? ConnectedClients { get; set; }
    private List<ActivityLogEntry> activityLog = new();
    private string? selectedClientConnectionId;
    private BingoSet? currentClientBingoSet;

    public class ActivityLogEntry
    {
        public DateTime Timestamp { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        // Initialize SignalR connection
        hubConnection = new HubConnectionBuilder()
            .WithUrl(AddressResolver.Address)
            .Build();
            
        // Set up event handlers
        hubConnection.On<object>("UserConnected", (data) =>
        {
            _ = InvokeAsync(async () =>
            {
                AddToLog("New user connected");
                await RefreshClients();
            });
        });

        hubConnection.On<object>("UserDisconnected", (data) =>
        {
            _ = InvokeAsync(async () =>
            {
                AddToLog("User disconnected");
                await RefreshClients();
            });
        });

        hubConnection.On<object>("ClientSquareUpdate", (data) =>
        {
            _ = InvokeAsync(async () =>
            {
                AddToLog($"Client updated a square");
                if (currentClientBingoSet != null && selectedClientConnectionId != null)
                {
                    await LoadClientBingoSet();
                }
            });
        });
        
        hubConnection.On<object>("BingoAchieved", (data) =>
        {
            _ = InvokeAsync(() =>
            {
                AddToLog("Bingo achieved");
                StateHasChanged();
            });
        });

        hubConnection.On<object>("ClientBingoSetGenerated", (data) =>
        {
            _ = InvokeAsync(async () =>
            {
                AddToLog("New bingo set generated for client");
                if (currentClientBingoSet != null && !string.IsNullOrEmpty(selectedClientConnectionId))
                {
                    await LoadClientBingoSet();
                }
                await RefreshClients();
            });
        });

        hubConnection.On<object>("ClientBingoSetUpdated", (data) =>
        {
            _ = InvokeAsync(async () =>
            {
                AddToLog("Bingo set updated for client");
                await RefreshClients();
            });
        });

        if (ConnectedClients is null)
        {
            ConnectedClients = new();
            await RefreshClients();
        }

        await hubConnection.StartAsync();
    }

    private async Task RefreshClients()
    {
        try
        {
            ConnectedClients = await ClientService.GetAllClientsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            AddToLog($"Error refreshing clients: {ex.Message}");
        }
    }

    private async Task LoadClientBingoSet()
    {
        if (string.IsNullOrEmpty(selectedClientConnectionId)) return;

        try
        {
            // selectedClientId is a connection ID, we need to get the persistent client ID
            var persistentClientId = await ClientService.GetPersistentClientIdAsync(selectedClientConnectionId);

            if (string.IsNullOrEmpty(persistentClientId))
            {
                AddToLog($"No persistent client ID found for connection {selectedClientConnectionId.Substring(0, 8)}...");
                return;
            }

            currentClientBingoSet = await BingoService.GetClientBingoSetAsync(persistentClientId);
            StateHasChanged();
            AddToLog($"Loaded bingo set for client {selectedClientConnectionId.Substring(0, 8)}... (persistent ID: {persistentClientId.Substring(0, 8)}...)");
            if (currentClientBingoSet is null)
            {
                AddToLog($"Client {selectedClientConnectionId} has no bingo set assigned.");
            }
        }
        catch (Exception ex)
        {
            AddToLog($"Error loading client bingo set: {ex.Message}");
        }
    }

    private async Task ToggleSquare(string squareId, bool isChecked)
    {
        if (string.IsNullOrEmpty(selectedClientConnectionId) || hubConnection == null) return;

        try
        {
            await hubConnection.SendAsync("AdminUpdateSquare", selectedClientConnectionId, squareId, isChecked);
            AddToLog($"Admin updated square {squareId} to {(isChecked ? "checked" : "unchecked")}");
            
            // Refresh the current board
            await Task.Delay(100); // Small delay to ensure the update is processed
            await LoadClientBingoSet();
        }
        catch (Exception ex)
        {
            AddToLog($"Error updating square: {ex.Message}");
        }
    }

    private async Task BroadcastMessage()
    {
        if (hubConnection == null) return;

        try
        {
            await hubConnection.SendAsync("BroadcastToAll", "Admin Message", "This is a test message from the admin");
            AddToLog("Broadcast message sent");
        }
        catch (Exception ex)
        {
            AddToLog($"Error broadcasting message: {ex.Message}");
        }
    }

    private void ClearLog()
    {
        activityLog.Clear();
        StateHasChanged();
    }

    private void AddToLog(string message)
    {
        activityLog.Add(new ActivityLogEntry
        {
            Timestamp = DateTime.Now,
            Message = message
        });
        
        // Keep only the last 100 entries
        if (activityLog.Count > 100)
        {
            activityLog.RemoveAt(0);
        }
        
        StateHasChanged();
    }

    private static string ShortId(string? id) => string.IsNullOrEmpty(id) ? string.Empty : id[..Math.Min(8, id.Length)];

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
