@page "/login"
@layout AuthLayout

<PageTitle>Sign in · AspiriFridays Admin</PageTitle>

<main class="login-container">
    <div class="login-card">
        <div class="login-brand">
            <img src="/aspire-logo-256.png" alt="" class="logo" />
            <span>AspiriFridays</span>
            <span class="login-tag">Admin</span>
        </div>
        <h1>Sign in</h1>

        <form method="post" action="/auth/login" data-enhance="false">
            <AntiforgeryToken />
            @if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }

            <label for="password" class="form-label">Password</label>
            <input id="password" name="password" type="password"
                   class="form-control"
                   autocomplete="current-password webauthn"
                   autofocus />

            <button type="submit" class="btn btn-primary btn-large">Sign in</button>

            <div class="divider"><span>or</span></div>

            <PasskeySubmit Operation="PasskeyOperation.Request" Name="passkey" class="btn btn-outline-secondary btn-large">
                <i class="fas fa-fingerprint" aria-hidden="true"></i>
                <span>Use a passkey</span>
            </PasskeySubmit>
        </form>

        <p class="info-text">Sessions last 24 hours.</p>
    </div>
</main>

@code {
    private string errorMessage = string.Empty;
    
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
    
    protected override void OnParametersSet()
    {
        errorMessage = Error switch
        {
            "invalid" => "Invalid password. Please try again.",
            "no-user" => "The user does not exist.",
            "passkey-error" => "Passkey authentication failed. Please try again.",
            "unexpected" => "Unable to sign in right now. Please try again.",
            _ => "",
        };
    }
}

<style>
    .login-container {
        display: grid;
        min-height: 100svh;
        place-items: center;
        padding: 1.5rem;
        background: var(--admin-canvas, #f7f7fa);
    }

    .login-card {
        width: 100%;
        max-width: 23rem;
        padding: 2rem;
        border: 1px solid var(--admin-line, #e4e2ec);
        border-radius: 10px;
        background: #fff;
    }

    .login-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.75rem;
        font-weight: 600;
    }

    .login-brand .logo {
        width: 1.5rem;
        height: 1.5rem;
    }

    .login-tag {
        padding: 0.0625rem 0.375rem;
        border: 1px solid var(--admin-line, #e4e2ec);
        border-radius: 4px;
        color: var(--admin-muted, #676479);
        font-size: 0.75rem;
        font-weight: 500;
    }

    .login-card h1 {
        margin: 0 0 1.25rem;
        font-size: 1.375rem;
        font-weight: 600;
    }

    .login-card .form-control {
        margin-bottom: 1rem;
    }

    .btn-large {
        display: flex;
        width: 100%;
        height: 2.5rem;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1rem 0;
        color: var(--admin-muted, #676479);
        font-size: 0.8125rem;
    }

    .divider::before,
    .divider::after {
        content: "";
        flex: 1;
        border-bottom: 1px solid var(--admin-line, #e4e2ec);
    }

    .info-text {
        margin: 1.5rem 0 0;
        color: var(--admin-muted, #676479);
        font-size: 0.8125rem;
    }

    @@media (max-width: 480px) {
        .login-container {
            place-items: start stretch;
            padding: 1rem;
        }

        .login-card {
            padding: 1.5rem;
        }
    }
</style>